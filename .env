# Optional Supabase integration (disabled by default). Leave blank to keep the app fully offline.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Gemini API key for AI Mock Test generation (disabled by default).
# If left blank, AI Mock Test screen shows a setup message instead of calling any API.
VITE_GEMINI_API_KEY=
